# Email Configuration for Reporting and Alerts
# Set EMAIL_ENABLED to 'true' to enable email functionality
EMAIL_ENABLED=false

# SMTP Server Settings (default is Gmail)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=465

# Sender Email Credentials
# For Gmail, use your email and app password (not regular password)
EMAIL_SENDER_EMAIL=your_email@gmail.com
EMAIL_SENDER_PASSWORD=your_app_password

# Recipient Email(s) - comma or semicolon separated for multiple
EMAIL_RECIPIENT_EMAIL=recipient@example.com

# Other configurations can be added here as needed
BACKEND_API_URL=http://localhost:8000
